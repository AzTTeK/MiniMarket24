# ---------- Base de datos (Local SQLite para Desarrollo/Pruebas) ----------
DATABASE_URL=sqlite:///./demand24_demo.db

# ---------- JWT ----------
JWT_SECRET=DEMAND24_SECRET_KEY_PROD

# ---------- MLflow ----------
MLFLOW_TRACKING_URI=http://localhost:5000
VITE_API_URL=http://localhost:8000/api/v1

# ---------- Configuración del Piloto ----------
PILOT_SKU_IDS=
MIN_WEEKS_HISTORY=12
MAPE_LOW_CONFIDENCE_THRESHOLD=35.0
ETL_SCHEDULE_CRON=0 5 * * 1

# ---------- App ----------
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000

# ---------- Módulo Analítico (ML) ----------
ML_RANDOM_SEED=42
ML_N_SPLITS=5
ML_CONFIDENCE_LEVEL=0.90
ML_XGBOOST_MAX_DEPTH=8
ML_XGBOOST_LEARNING_RATE=0.03
ML_XGBOOST_N_ESTIMATORS=300
ML_XGBOOST_SUBSAMPLE=0.85
ML_XGBOOST_COLSAMPLE_BYTREE=0.85
