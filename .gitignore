# ===========================
# DEMAND-24 .gitignore
# ===========================

# ---------- Secretos y configuracion local ----------
.env
.env.*
!.env.example
*.pem
*.key

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.eggs/

# ---------- Entornos virtuales ----------
venv/
.venv/
env/

# ---------- Datos (archivos pesados y sensibles) ----------
data/raw/
data/processed/
data/external/
*.csv
*.db
*.sqlite
mlruns/
mlflow-data/

# ---------- Modelos ML entrenados ----------
modulo_analitico/models/saved/
*.pkl
*.joblib
*.h5
*.model
*.xgb

# ---------- Reportes de cobertura y tests ----------
.coverage
coverage.xml
.pytest_cache/
htmlcov/

# ---------- Frontend: dependencias y build ----------
frontend/node_modules/
frontend/dist/
frontend/build/
.next/

# ---------- Notebooks: outputs (solo se sube el codigo fuente) ----------
notebooks/.ipynb_checkpoints/

# ---------- IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Logs ----------
*.log

# ---------- Documentacion interna (no relevante para el despliegue) ----------
*.md
!README.md

# ---------- Herramientas de CI/CD y agentes ----------
.agents/
.vercel
scratch/
