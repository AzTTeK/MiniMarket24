# ===========================
# DEMAND-24 .gitignore (Optimizado para Transición)
# ===========================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.eggs/

# ---------- Virtual Environments ----------
venv/
.venv/
env/

# ---------- IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Environment & Secrets ----------
# .env  <-- PERMITIDO para la transición
! .env
*.pem
*.key

# ---------- Documentation ----------
# *.md  <-- PERMITIDO para la transición
! *.md

# ---------- Data (Ignorados por peso) ----------
data/raw/
data/processed/
*.csv
*.db
mlflow-data/
mlruns/
*.pkl
*.joblib
*.h5

# ---------- Node / Frontend ----------
node_modules/
frontend/dist/
frontend/build/
.next/

# ---------- Docker & Logs ----------
*.log

# ---------- Gemini Agent ----------
.agents/
.vercel
